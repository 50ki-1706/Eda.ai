{
  "name": "new-approuter-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "check": "biome check",
    "format": "biome check --write .",
    "format:prettier": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit --runExternalCode",
    "db:push": "docker compose up -d db && docker compose exec -T db psql -U root -d db < db/schema.sql",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.139",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@better-auth/kysely-adapter": "^1.7.18",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/valibot": "1.16.2",
    "ai": "^7.0.166",
    "better-auth": "^1.7.18",
    "formidable": "^3.5.3",
    "kysely": "^0.29.8",
    "lucide-react": "^0.488.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "postgres": "^4.1.0",
    "react": "^19.2.5",
    "react-avatar-editor": "^13.0.2",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "reylo": "^0.7.0",
    "swr": "^2.3.3",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.25.0",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "^1.11.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typed-css-modules-mapper": "0.1.0",
    "typescript": "7.1.0-beta",
    "typescript-eslint": "^8.30.1"
  },
  "overrides": {
    "react-avatar-editor": {
      "react": ">=18.0.0",
      "react-dom": ">=18.0.0"
    }
  }
}
