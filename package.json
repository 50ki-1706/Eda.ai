{
  "name": "new-approuter-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "check": "biome check",
    "format": "biome check --write .",
    "format:prettier": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit --runExternalCode",
    "db:push": "docker compose up -d db && docker compose exec -T db psql -U root -d db < db/schema.sql",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.7.18",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google/genai": "^1.13.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@trpc/client": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "ai": "^6.0.86",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "config": "^3.3.12",
    "formidable": "^3.5.3",
    "kysely": "^0.29.8",
    "lucide-react": "^0.488.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "postgres": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "react": "^19.2.5",
    "react-avatar-editor": "^13.0.2",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "reylo": "^0.7.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "^1.11.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "7.1.0-beta",
    "typescript-eslint": "^8.30.1"
