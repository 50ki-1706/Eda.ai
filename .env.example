BETTER_AUTH_SECRET=*****************************
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL="postgresql://root:root@localhost:5432/db"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GOOGLE_CLIENT_ID=***********************************************************
# GOOGLE_CLIENT_SECRET=*********************************:

# ユーザーが登録した API キーを暗号化するためのシークレット（必須）
# 32 文字以上のランダムな文字列を設定する。例: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=your_random_secret_at_least_32_chars

# Vercel AI Gateway の API キー（必須）
# Google AI Studio のキーを BYOK 経由で使う際の Gateway 認証に使用する
# 取得: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here

# 注: OpenRouter / OpenCode Zen / Google AI Studio の API キーは
# 各ユーザーがアプリの設定画面（/settings）から登録する。
# サーバー側の環境変数としては不要。
